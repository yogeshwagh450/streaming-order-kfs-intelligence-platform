# -------------------------------------------------------------------
# Application
# -------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO

# -------------------------------------------------------------------
# Confluent Cloud Kafka
# -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=<confluent-bootstrap-server>
KAFKA_API_KEY=<kafka-cluster-api-key>
KAFKA_API_SECRET=<kafka-cluster-api-secret>
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN

KAFKA_SOURCE_TOPIC=orders.events.v1
KAFKA_VALIDATED_TOPIC=orders.validated.v1
KAFKA_METRICS_TOPIC=orders.customer-metrics.v1
KAFKA_DLQ_TOPIC=orders.dlq.v1

KAFKA_PRODUCER_CLIENT_ID=order-producer-dev
KAFKA_CONSUMER_GROUP_ID=diagnostic-consumer-dev
FLINK_CONSUMER_GROUP_ID=order-stream-flink-dev

# -------------------------------------------------------------------
# Confluent Cloud Schema Registry
# -------------------------------------------------------------------
SCHEMA_REGISTRY_URL=<schema-registry-url>
SCHEMA_REGISTRY_API_KEY=<schema-registry-api-key>
SCHEMA_REGISTRY_API_SECRET=<schema-registry-api-secret>

# -------------------------------------------------------------------
# Snowflake
# -------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=<snowflake-account-identifier>
SNOWFLAKE_USER=<snowflake-user>
SNOWFLAKE_PASSWORD=<local-development-only>
SNOWFLAKE_ROLE=STREAMING_DEV_ROLE
SNOWFLAKE_WAREHOUSE=STREAMING_WH
SNOWFLAKE_DATABASE=STREAMING_DB
SNOWFLAKE_SCHEMA=RAW

# Preferred for connector/service authentication
SNOWFLAKE_PRIVATE_KEY_PATH=<local-path-not-committed>
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<private-key-passphrase>
